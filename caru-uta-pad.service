[Unit]
Description=Caru Uta Pad static web app
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/caru-uta-pad
Environment=HOST=0.0.0.0
Environment=PORT=8090
Environment=NCM_API_ORIGIN=http://127.0.0.1:3000
ExecStart=/root/.nvm/versions/node/v22.12.0/bin/node /root/caru-uta-pad/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
